# Models for javmem's fact store (memv2-lite). Copy to .env and keep ONE of the blocks below. The same names as the
# graph recipe's .env, so backend A uses one file for both. The keys stay on this computer.
#
# What it costs: one model call per stretch of conversation (up to 8 messages), counted from what the model
# reports; MEMV2_DAILY_TOKENS caps a day (default 1,000,000), and it goes on the next day. Facts remembered by
# another AI (javmem-inherit) go in without a model call.

# ---- 1. OpenAI ----
MODEL_NAME=gpt-6-luna
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_API_URL=https://api.openai.com/v1
EMBEDDER_API_KEY=sk-...

# ---- 2. DeepSeek for the facts, Qwen (Alibaba DashScope) for the vectors ----
# MODEL_NAME=deepseek-chat
# OPENAI_API_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# EMBEDDER_MODEL=text-embedding-v4
# EMBEDDER_DIM=1024
# EMBEDDER_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDER_API_KEY=sk-...

# ---- 3. Ollama on this computer (free; `ollama pull qwen3:14b` and `ollama pull qwen3-embedding:0.6b`) ----
# MODEL_NAME=qwen3:14b
# OPENAI_API_URL=http://host.docker.internal:11434/v1   # without Docker: http://127.0.0.1:11434/v1
# OPENAI_API_KEY=ollama
# EMBEDDER_MODEL=qwen3-embedding:0.6b
# EMBEDDER_API_URL=http://host.docker.internal:11434/v1
# EMBEDDER_API_KEY=ollama

# ---- Optional ----
# MEMV2_DAILY_TOKENS=1000000        # tokens a day; 0 = no limit
# MEMV2_MODEL_CHEAP=deepseek-chat   # a cheaper model for short stretches (<= 1,600 characters and <= 4 messages)
# MEMV2_REASONING_EFFORT=low        # for reasoning models: none | low | medium | high
# MEMV2_JSON_MODE=json_object       # none if the service does not take response_format
# MEMV2_EXTRA_BODY={}               # extra JSON fields sent with every model call (a provider's own switches)
# MEMV2_PORT=8766                   # the port on 127.0.0.1 (Docker)
# HTTPS_PROXY=http://host.docker.internal:7890   # if the model service is only reachable through a proxy
