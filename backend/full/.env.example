# Models for javmem's full set: the fact store (memv2-lite) and the graph (Graphiti) read the same names.
# Copy to .env and keep ONE of the three blocks. The keys stay on this computer, in this file.
#
# What it costs, measured 2026-11-06 with gpt-6-luna on made-up conversations: the fact store about 1,600 tokens and
# the graph about 15,000 tokens per stretch of a few messages; roughly 600,000 + 2,500,000 tokens per 1,000
# messages. Each has a daily limit: MEMV2_DAILY_TOKENS here, and javmem-feed --daily-tokens for the graph.

# ---- The graph database: Neo4j ----
# Choose a password, at least 8 characters. It is set when the database is first created. (Not needed with
# docker-compose.falkordb.yml, the one-container choice without Neo4j.)
NEO4J_PASSWORD=

# ---- 1. OpenAI ----
MODEL_NAME=gpt-6-luna
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_DIM=1536
EMBEDDER_API_URL=https://api.openai.com/v1
EMBEDDER_API_KEY=sk-...

# ---- 2. DeepSeek for extraction, Qwen (Alibaba DashScope) for the vectors ----
# MODEL_NAME=deepseek-chat
# OPENAI_API_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# EMBEDDER_MODEL=text-embedding-v4
# EMBEDDER_DIM=1024
# EMBEDDER_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDER_API_KEY=sk-...

# ---- 3. Everything on this computer: docker compose --profile local up -d --build ----
# MODEL_NAME=qwen3:14b
# OPENAI_API_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# EMBEDDER_MODEL=qwen3-embedding:0.6b
# EMBEDDER_DIM=1024
# EMBEDDER_API_URL=http://ollama:11434/v1
# EMBEDDER_API_KEY=ollama
# SEMAPHORE_LIMIT=1

# ---- Optional ----
# MEMV2_DAILY_TOKENS=1000000
# MEMV2_MODEL_CHEAP=            # a cheaper model for short stretches in the fact store
# MEMV2_PORT=8766
# GRAPHITI_PORT=8000
# NEO4J_HTTP_PORT=17474
# NEO4J_BOLT_PORT=17687
# NEO4J_HEAP_MAX=1G
# NEO4J_PAGECACHE=512m
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=host.docker.internal,localhost,127.0.0.1,ollama
