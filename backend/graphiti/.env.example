# Models for javmem's graph store. Copy to .env and keep ONE of the three blocks below (delete or comment out the
# others). The keys stay on this computer, in this file; javmem never reads them.
#
# What it costs: Graphiti asks the model several times per stretch of conversation ("episode", up to 8 messages);
# measured 2026-11-06 with gpt-6-luna, about 15,000 tokens per short episode. javmem counts 20,000, roughly
# 2.5 million tokens per 1,000 messages, and javmem-feed stops at a daily limit (--daily-tokens, default 1,000,000).
# With Ollama it costs nothing but needs a strong computer and is much slower.

# ---- The graph database: Neo4j ----
# Choose a password, at least 8 characters. It is set when the database is first created. (Not needed with
# docker-compose.falkordb.yml, the one-container choice without Neo4j.)
NEO4J_PASSWORD=

# ---- 1. OpenAI (the official default) ----
MODEL_NAME=gpt-6-luna
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBEDDER_MODEL=text-embedding-3-small
EMBEDDER_DIM=1536
EMBEDDER_API_URL=https://api.openai.com/v1
EMBEDDER_API_KEY=sk-...

# ---- 2. DeepSeek for the graph, Qwen (Alibaba DashScope) for the vectors: cheap, works well with Chinese ----
# MODEL_NAME=deepseek-chat
# OPENAI_API_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# EMBEDDER_MODEL=text-embedding-v4
# EMBEDDER_DIM=1024
# EMBEDDER_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDER_API_KEY=sk-...

# ---- 3. Everything on this computer with Ollama (free; `ollama pull qwen3:14b` and `ollama pull qwen3-embedding:0.6b`) ----
# MODEL_NAME=qwen3:14b
# OPENAI_API_URL=http://host.docker.internal:11434/v1
# OPENAI_API_KEY=ollama
# LLM_STRUCTURED_OUTPUT_MODE=json_object
# EMBEDDER_MODEL=qwen3-embedding:0.6b
# EMBEDDER_DIM=1024
# EMBEDDER_API_URL=http://host.docker.internal:11434/v1
# EMBEDDER_API_KEY=ollama
# SEMAPHORE_LIMIT=1

# ---- Optional ----
# GRAPHITI_PORT=8000          # the port on 127.0.0.1
# NEO4J_HTTP_PORT=17474       # Neo4j's web page for looking at the graph, on 127.0.0.1
# NEO4J_BOLT_PORT=17687       # the port that page connects to
# NEO4J_HEAP_MAX=1G           # Neo4j's memory: heap (at most) and page cache
# NEO4J_PAGECACHE=512m
# SEMAPHORE_LIMIT=2           # episodes processed at once; lower it when the model service says "too many requests"
# HTTPS_PROXY=http://host.docker.internal:7890   # if the model service is only reachable through a proxy
# NO_PROXY=host.docker.internal,localhost,127.0.0.1
